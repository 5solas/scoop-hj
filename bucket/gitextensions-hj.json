{
    "version": "7.3.0.4",
    "description": "Git Extensions hj fork: Ghostty console and faster repository opening.",
    "homepage": "https://github.com/5solas/gitextensions",
    "license": "GPL-3.0-only",
    "notes": "Portable build of the hj fork. Settings are kept in $persist_dir and do not affect an upstream Git Extensions install.",
    "suggest": {
        ".NET Desktop Runtime 10": "extras/windowsdesktop-runtime"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/5solas/gitextensions/releases/download/hj/v7.3.0-hj-4/GitExtensions-Portable-x64-7.3.0.4-hj-4-6092e5ea1.zip",
            "hash": "ee3faa920358b756fa7e0c4ba869c5049fc9519dfa8a79412a77cdc9021de249"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\GitExtensions.settings\")) { New-Item \"$dir\\GitExtensions.settings\" | Out-Null }",
    "bin": [
        [
            "GitExtensions.exe",
            "gite-hj"
        ]
    ],
    "shortcuts": [
        [
            "GitExtensions.exe",
            "Git Extensions (hj)"
        ]
    ],
    "persist": "GitExtensions.settings",
    "checkver": {
        "github": "https://api.github.com/repos/5solas/gitextensions/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "/hj/v(?<tag>[\\d.]+-hj-\\d+)/GitExtensions-Portable-x64-(?<version>[\\d.]+)-hj-\\d+-(?<commit>\\w+)\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/5solas/gitextensions/releases/download/hj/v$matchTag/GitExtensions-Portable-x64-$version-hj-$buildVersion-$matchCommit.zip"
            }
        }
    }
}
